<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Collegio Mazza — Valutazione</title>
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700;800;900&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
:root{
  /* === Collegio Mazza Brand Colors === */
  --blue:#1460A8;
  --blue2:#1B72C0;
  --blue-light:rgba(20,96,168,.10);
  --blue-glow:rgba(20,96,168,.28);
  --blue-dark:#0e4a84;

  --orange:#F5821F;
  --orange2:#e87010;
  --orange-light:rgba(245,130,31,.10);
  --orange-glow:rgba(245,130,31,.30);

  --red:#d94040;
  --red-light:rgba(217,64,64,.10);

  /* === Light theme surfaces === */
  --bg:#f4f6fa;
  --surface:#ffffff;
  --surface2:#eef1f7;
  --surface3:#e4e8f2;

  /* === Text === */
  --text:#0e1c33;
  --text2:#3a4a62;
  --text3:#7a8ba8;

  /* === Borders === */
  --border:rgba(20,96,168,.12);
  --border2:rgba(20,96,168,.22);

  --white:#ffffff;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;font-size:16px;}

body{
  font-family:'Raleway',sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}

/* Subtle geometric background pattern */
body::before{
  content:'';position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:
    radial-gradient(circle at 0% 0%, rgba(20,96,168,.06) 0%, transparent 50%),
    radial-gradient(circle at 100% 100%, rgba(245,130,31,.06) 0%, transparent 50%);
}

.app{position:relative;z-index:1;min-height:100vh;}

/* ── TOPBAR ── */
.topbar{
  position:fixed;top:0;left:0;right:0;z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 40px;height:64px;
  background:rgba(255,255,255,.92);
  border-bottom:1px solid var(--border);
  backdrop-filter:blur(20px);
  box-shadow:0 1px 16px rgba(20,96,168,.08);
}
.topbar-logo{
  display:flex;align-items:center;gap:14px;text-decoration:none;
}
.logo-svg{height:36px;width:auto;display:block;}
.topbar-badge{
  font-size:.68rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--blue2);padding:6px 14px;
  border:1.5px solid var(--border2);border-radius:100px;
  background:var(--blue-light);
}
.topbar-right{display:flex;align-items:center;gap:12px;}
.btn-back-home{
  display:none;
  align-items:center;gap:7px;
  padding:8px 16px;border-radius:100px;
  background:transparent;border:1.5px solid var(--border2);
  color:var(--text2);font-family:'Raleway',sans-serif;
  font-size:.72rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;
  cursor:pointer;transition:all .2s;white-space:nowrap;
}
.btn-back-home:hover{border-color:var(--blue);color:var(--blue);background:var(--blue-light);}

/* ── CONFIRM MODAL ── */
.modal-overlay{
  display:none;position:fixed;inset:0;z-index:200;
  background:rgba(14,28,51,.45);
  backdrop-filter:blur(6px);
  align-items:center;justify-content:center;
  animation:fadeIn .18s ease;
}
.modal-overlay.open{display:flex;}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal-box{
  background:var(--surface);
  border:1.5px solid var(--border2);
  border-radius:18px;
  padding:36px 32px 28px;
  max-width:380px;width:90%;
  text-align:center;
  box-shadow:0 20px 60px rgba(14,28,51,.2);
  animation:scaleIn .22s cubic-bezier(.34,1.56,.64,1);
}
.modal-icon{font-size:2rem;margin-bottom:12px;}
.modal-title{font-family:'Lora',serif;font-size:1.25rem;font-weight:600;color:var(--blue);margin-bottom:8px;}
.modal-desc{font-size:.85rem;color:var(--text2);line-height:1.6;margin-bottom:24px;}
.modal-actions{display:flex;gap:10px;justify-content:center;}
.modal-cancel{
  padding:10px 22px;border-radius:100px;
  background:transparent;border:1.5px solid var(--border2);
  color:var(--text2);font-family:'Raleway',sans-serif;
  font-size:.78rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;
  cursor:pointer;transition:all .2s;
}
.modal-cancel:hover{border-color:var(--text3);color:var(--text);}
.modal-confirm{
  padding:10px 22px;border-radius:100px;
  background:var(--blue);border:none;
  color:#fff;font-family:'Raleway',sans-serif;
  font-size:.78rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;
  cursor:pointer;transition:all .2s;
  box-shadow:0 4px 14px var(--blue-glow);
}
.modal-confirm:hover{background:var(--orange);box-shadow:0 4px 14px var(--orange-glow);}

/* ── LANDING ── */
#landing{
  min-height:100vh;display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  padding:100px 20px 60px;
  animation:fadeUp .8s cubic-bezier(.16,1,.3,1) both;
}

.landing-eyebrow{
  font-size:.7rem;letter-spacing:4px;text-transform:uppercase;
  color:var(--orange);font-weight:700;margin-bottom:24px;
  display:flex;align-items:center;gap:12px;
}
.landing-eyebrow::before,.landing-eyebrow::after{
  content:'';flex:1;height:1px;background:var(--border2);max-width:60px;
}

.landing-headline{
  font-family:'Lora',serif;
  font-size:clamp(2.4rem,5vw,3.8rem);
  font-weight:400;line-height:1.15;
  text-align:center;color:var(--blue);
  max-width:640px;margin-bottom:16px;
}
.landing-headline em{
  font-style:italic;color:var(--orange);
}

.landing-sub{
  font-size:.95rem;color:var(--text2);line-height:1.7;
  text-align:center;max-width:480px;margin-bottom:56px;font-weight:400;
}

/* ── QUIZ CARDS ── */
.quiz-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:12px;width:100%;max-width:880px;margin-bottom:36px;
}
.quiz-card{
  display:flex;align-items:center;gap:18px;
  padding:20px 22px;
  background:var(--surface);
  border:1.5px solid var(--border);
  border-radius:14px;cursor:pointer;
  transition:all .22s cubic-bezier(.4,0,.2,1);
  text-align:left;
  box-shadow:0 2px 8px rgba(20,96,168,.06);
}
.quiz-card:hover{
  border-color:var(--blue2);
  transform:translateY(-3px);
  box-shadow:0 8px 28px rgba(20,96,168,.14);
}
.quiz-card.active{
  border-color:var(--blue);
  background:var(--blue-light);
  box-shadow:0 0 0 1px var(--blue), 0 8px 28px rgba(20,96,168,.18);
}
.quiz-card.active .qc-icon{background:var(--blue);}
.qc-icon{
  width:44px;height:44px;border-radius:10px;
  background:var(--surface2);
  display:flex;align-items:center;justify-content:center;
  font-size:1.3rem;flex-shrink:0;
  transition:background .22s;
}
.qc-body{flex:1;min-width:0;}
.qc-name{font-size:.92rem;font-weight:700;color:var(--text);margin-bottom:3px;}
.qc-desc{font-size:.75rem;color:var(--text3);line-height:1.4;}
.qc-time{
  font-size:.68rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;
  color:var(--blue2);margin-top:6px;display:block;
}
.qc-check{
  width:22px;height:22px;border-radius:50%;
  border:2px solid var(--border2);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;transition:all .22s;
  font-size:.7rem;color:transparent;
}
.quiz-card.active .qc-check{
  background:var(--blue);border-color:var(--blue);color:#fff;
}

.start-btn{
  padding:15px 52px;
  background:var(--blue);
  color:#fff;
  border:none;border-radius:10px;cursor:pointer;
  font-family:'Raleway',sans-serif;font-size:.88rem;
  font-weight:800;letter-spacing:2px;text-transform:uppercase;
  transition:all .22s ease;
  box-shadow:0 6px 20px var(--blue-glow);
}
.start-btn:hover:not(:disabled){
  background:var(--orange);
  box-shadow:0 10px 28px var(--orange-glow);
  transform:translateY(-2px);
}
.start-btn:disabled{opacity:.3;cursor:not-allowed;}

/* ── SURVEY ── */
#survey{
  display:none;padding-top:80px;min-height:100vh;
  width:100%;max-width:720px;margin:0 auto;padding-left:24px;padding-right:24px;
  animation:fadeUp .5s cubic-bezier(.16,1,.3,1) both;
}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

.prog-header{padding:32px 0 28px;}
.prog-meta{
  display:flex;justify-content:space-between;align-items:center;
  margin-bottom:12px;
}
.prog-label{font-size:.72rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--text3);}
.prog-fraction{font-size:.72rem;font-weight:700;color:var(--blue2);}
.prog-bar{height:3px;background:var(--surface3);border-radius:3px;overflow:hidden;}
.prog-fill{
  height:100%;background:linear-gradient(90deg,var(--blue),var(--blue2));border-radius:3px;
  transition:width .6s cubic-bezier(.4,0,.2,1);
  box-shadow:0 0 10px var(--blue-glow);
}

.sec-head{margin-bottom:28px;}
.sec-eyebrow{
  font-size:.68rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;
  color:var(--orange);margin-bottom:10px;
}
.sec-title{
  font-family:'Lora',serif;
  font-size:1.6rem;font-weight:600;color:var(--blue);line-height:1.2;
}

.staff-badge{
  display:flex;align-items:center;gap:16px;
  padding:16px 20px;border-radius:12px;
  border:1.5px solid var(--border);
  background:var(--surface);
  margin-bottom:20px;
  box-shadow:0 2px 8px rgba(20,96,168,.06);
}
.sb-icon{font-size:1.8rem;}
.sb-role{font-size:.88rem;font-weight:700;color:var(--text);}
.sb-desc{font-size:.75rem;color:var(--text3);margin-top:2px;}

.info-note{
  display:flex;gap:12px;align-items:flex-start;
  background:var(--orange-light);border:1px solid rgba(245,130,31,.25);
  border-radius:8px;padding:12px 16px;
  color:var(--text2);font-size:.8rem;line-height:1.5;
  margin-bottom:20px;
}

/* ── QUESTION CARDS ── */
.q-card{
  background:var(--surface);
  border:1.5px solid var(--border);
  border-radius:14px;padding:24px;
  margin-bottom:14px;
  transition:border-color .2s, box-shadow .2s;
  animation:fadeUp .3s ease both;
  box-shadow:0 2px 8px rgba(20,96,168,.05);
}
.q-card:focus-within{
  border-color:var(--blue2);
  box-shadow:0 4px 16px rgba(20,96,168,.12);
}
.q-num{
  font-size:.65rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;
  color:var(--text3);margin-bottom:10px;
}
.q-text{
  font-size:.95rem;font-weight:600;color:var(--text);
  line-height:1.55;margin-bottom:20px;
}
.q-card.unanswered{border-color:rgba(217,64,64,.5);animation:shake .35s ease;}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}

/* ── LIKERT ── */
.likert-row{display:flex;gap:7px;}
.l-opt{
  flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;
  padding:12px 4px;border-radius:10px;cursor:pointer;
  border:1.5px solid var(--border);background:transparent;
  transition:all .18s ease;user-select:none;
}
.l-opt:hover{border-color:var(--blue2);background:var(--blue-light);}
.l-num{font-size:1.1rem;font-weight:800;color:var(--text3);transition:color .18s;}
.l-lbl{font-size:.6rem;text-align:center;color:var(--text3);line-height:1.2;transition:color .18s;}

.l-opt.sel-1{background:var(--red-light);border-color:var(--red);}
.l-opt.sel-1 .l-num{color:var(--red);}
.l-opt.sel-2{background:rgba(245,130,31,.08);border-color:var(--orange);}
.l-opt.sel-2 .l-num{color:var(--orange);}
.l-opt.sel-3{background:var(--surface2);border-color:var(--text3);}
.l-opt.sel-3 .l-num{color:var(--text2);}
.l-opt.sel-4{background:var(--blue-light);border-color:var(--blue);}
.l-opt.sel-4 .l-num{color:var(--blue);}
.l-opt.sel-5{background:rgba(20,96,168,.16);border-color:var(--blue2);}
.l-opt.sel-5 .l-num{color:var(--blue2);}
.l-opt[class*="sel-"] .l-lbl{color:var(--text2);}

/* ── NPS ── */
.nps-row{display:flex;gap:5px;flex-wrap:wrap;}
.nps-opt{
  flex:1;min-width:36px;
  display:flex;align-items:center;justify-content:center;
  padding:10px 4px;border-radius:8px;cursor:pointer;
  border:1.5px solid var(--border);background:transparent;
  font-size:.9rem;font-weight:800;color:var(--text3);
  transition:all .18s ease;user-select:none;
}
.nps-opt:hover{border-color:var(--blue2);color:var(--blue);}
.nps-opt.nsel{transform:translateY(-2px);}
.nps-opt.nsel-low{background:var(--red-light);border-color:var(--red);color:var(--red);}
.nps-opt.nsel-mid{background:var(--orange-light);border-color:var(--orange);color:var(--orange2);}
.nps-opt.nsel-high{background:rgba(20,96,168,.14);border-color:var(--blue2);color:var(--blue);}
.nps-labels{display:flex;justify-content:space-between;margin-top:8px;
  font-size:.68rem;color:var(--text3);font-weight:500;}

/* ── MC ── */
.mc-row{display:flex;flex-wrap:wrap;gap:8px;}
.mc-opt{
  padding:9px 18px;border-radius:100px;cursor:pointer;
  border:1.5px solid var(--border);background:transparent;
  color:var(--text2);font-size:.82rem;font-weight:600;
  transition:all .18s ease;user-select:none;
}
.mc-opt:hover{border-color:var(--blue2);color:var(--blue);}
.mc-opt.msel{
  background:var(--blue-light);border-color:var(--blue);color:var(--blue);font-weight:700;
}

/* ── YES/NO ── */
.yn-row{display:flex;gap:10px;flex-wrap:wrap;}
.yn-opt{
  flex:1;min-width:120px;
  display:flex;align-items:center;justify-content:center;gap:8px;
  padding:13px;border-radius:10px;cursor:pointer;
  border:1.5px solid var(--border);background:transparent;
  font-size:.85rem;font-weight:700;color:var(--text3);
  transition:all .22s ease;user-select:none;
}
.yn-opt:hover{border-color:var(--blue2);color:var(--blue);}
.yn-si.ysel{background:rgba(20,96,168,.14);border-color:var(--blue);color:var(--blue);}
.yn-no.ysel{background:var(--red-light);border-color:var(--red);color:var(--red);}
.yn-na.ysel{background:var(--surface2);border-color:var(--text3);color:var(--text2);}

/* ── NAV BAR ── */
.nav-bar{
  display:flex;justify-content:space-between;align-items:center;
  padding:24px 0 48px;gap:12px;
}
.btn-prev{
  padding:12px 28px;border-radius:100px;
  background:transparent;border:1.5px solid var(--border2);
  color:var(--text3);font-family:'Raleway',sans-serif;font-size:.8rem;
  font-weight:700;letter-spacing:1.5px;text-transform:uppercase;
  cursor:pointer;transition:all .2s;
}
.btn-prev:hover{border-color:var(--blue2);color:var(--blue);}
.btn-next{
  padding:13px 40px;border-radius:100px;
  background:var(--blue);border:none;
  color:#fff;font-family:'Raleway',sans-serif;font-size:.8rem;
  font-weight:800;letter-spacing:1.5px;text-transform:uppercase;
  cursor:pointer;transition:all .22s;
  box-shadow:0 4px 16px var(--blue-glow);
}
.btn-next:hover{background:var(--orange);box-shadow:0 6px 24px var(--orange-glow);}
.hint{
  text-align:center;font-size:.75rem;color:var(--red);
  min-height:16px;margin-top:-8px;margin-bottom:8px;font-weight:600;
}

/* ── COMPLETION ── */
#completion{
  display:none;min-height:100vh;
  flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:100px 24px 60px;
  animation:fadeUp .8s cubic-bezier(.16,1,.3,1) both;
}
.comp-mark{
  width:72px;height:72px;border-radius:50%;
  background:var(--blue-light);border:2px solid var(--blue);
  display:flex;align-items:center;justify-content:center;
  font-size:2rem;margin:0 auto 32px;color:var(--blue);
  animation:scaleIn .6s cubic-bezier(.34,1.56,.64,1) both .3s;
}
@keyframes scaleIn{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}
.comp-eyebrow{
  font-size:.68rem;letter-spacing:4px;text-transform:uppercase;
  color:var(--orange);font-weight:700;margin-bottom:16px;
}
.comp-title{
  font-family:'Lora',serif;
  font-size:clamp(2rem,4vw,3rem);font-weight:600;
  color:var(--blue);margin-bottom:16px;line-height:1.15;
}
.comp-sub{color:var(--text2);font-size:.95rem;line-height:1.7;max-width:460px;margin:0 auto 40px;}
.comp-stats{
  display:flex;gap:1px;border:1.5px solid var(--border);border-radius:14px;
  overflow:hidden;margin-bottom:40px;
  box-shadow:0 4px 16px rgba(20,96,168,.08);
}
.stat-item{
  flex:1;padding:20px;background:var(--surface);
  border-right:1px solid var(--border);
}
.stat-item:last-child{border-right:none;}
.stat-n{font-family:'Lora',serif;font-size:2rem;font-weight:600;color:var(--blue);}
.stat-l{font-size:.68rem;letter-spacing:1.5px;text-transform:uppercase;color:var(--text3);margin-top:4px;}
.btn-restart{
  padding:13px 40px;border-radius:100px;
  background:transparent;border:1.5px solid var(--border2);
  color:var(--text2);font-family:'Raleway',sans-serif;
  font-size:.8rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  cursor:pointer;transition:all .22s;
}
.btn-restart:hover{border-color:var(--blue);color:var(--blue);}

/* ── NA button (non ho interagito) ── */
.na-row{margin-top:10px;}
.na-btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:7px 16px;border-radius:100px;cursor:pointer;
  border:1.5px dashed var(--border2);background:transparent;
  color:var(--text3);font-family:'Raleway',sans-serif;
  font-size:.75rem;font-weight:700;letter-spacing:.5px;
  transition:all .18s ease;user-select:none;
}
.na-btn:hover{border-color:var(--text3);color:var(--text2);}
.na-btn.na-sel{
  border-style:solid;
  border-color:var(--text3);
  background:var(--surface2);
  color:var(--text2);
}

/* ── Group label ── */
.quiz-grid{grid-template-columns:1fr;}
.group-label{
  grid-column:1/-1;
  padding:8px 4px 4px;
  font-size:.68rem;font-weight:800;letter-spacing:3px;text-transform:uppercase;
  color:var(--text3);border-bottom:1px solid var(--border);
  margin-top:8px;
}
.group-label:first-child{margin-top:0;}
.qc-tags{font-size:.68rem;color:var(--blue2);font-weight:600;margin-top:3px;opacity:.7;}

/* ── Open text ── */
.q-card.q-text-card{
  border:2px solid var(--orange);
  background:linear-gradient(135deg,rgba(245,130,31,.07) 0%,rgba(245,130,31,.03) 100%);
  box-shadow:0 4px 20px rgba(245,130,31,.12);
  padding:28px 26px 22px;
}
.open-top{
  display:flex;align-items:flex-start;justify-content:space-between;
  gap:16px;margin-bottom:14px;
}
.open-icon-wrap{
  flex-shrink:0;
  width:44px;height:44px;border-radius:12px;
  background:rgba(245,130,31,.15);
  display:flex;align-items:center;justify-content:center;
  font-size:1.3rem;
}
.open-header{flex:1;}
.open-badge{
  display:inline-flex;align-items:center;gap:5px;
  padding:3px 10px;border-radius:100px;
  background:rgba(245,130,31,.15);
  border:1px solid rgba(245,130,31,.35);
  font-size:.62rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--orange2);margin-bottom:8px;
}
.open-prompt{
  font-family:'Lora',serif;
  font-size:1.02rem;font-weight:600;color:var(--text);
  line-height:1.5;
}
.open-wrap{display:flex;flex-direction:column;gap:8px;}
.open-ta{
  width:100%;min-height:110px;resize:none;
  background:rgba(255,255,255,.75);
  border:1.5px solid rgba(245,130,31,.3);border-radius:12px;
  padding:14px 16px;
  font-family:'Raleway',sans-serif;font-size:.9rem;color:var(--text);
  line-height:1.65;transition:border-color .2s,box-shadow .2s,background .2s;outline:none;
}
